/* ================= 跳转 & 弹窗 ================= */
function goToPage(num) {
  const el = document.getElementById('page' + num);
  if (el) el.scrollIntoView({ behavior: 'smooth' });
}

function showTooltip(el, text) {
  if (!el) return;
  el.textContent = text;
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 2800);
}

/* ================= 釉色选择 ================= */
document.querySelectorAll('[data-glaze]').forEach(btn => {
  btn.addEventListener('click', function () {
    document.querySelectorAll('[data-glaze]').forEach(b => b.classList.remove('active'));
    this.classList.add('active');

    currentGlaze = this.dataset.glaze;

    document.querySelectorAll('.dog').forEach(dog => {
      dog.classList.remove('glaze-clay', 'glaze-green', 'glaze-yellow');
      dog.classList.add('glaze-' + currentGlaze);
    });

    showTooltip(document.getElementById('glazeTooltip'), this.dataset.tip);
  });
});

/* ================= 纹饰选择 ================= */
document.querySelectorAll('[data-pattern]').forEach(btn => {
  btn.addEventListener('click', function () {
    document.querySelectorAll('[data-pattern]').forEach(b => b.classList.remove('active'));
    this.classList.add('active');

    currentPattern = this.dataset.pattern;

    document.querySelectorAll('.dog-collar').forEach(collar => {
      collar.classList.remove('pattern-plain', 'pattern-cloud', 'pattern-whorl');
      collar.classList.add('pattern-' + currentPattern);
    });

    showTooltip(document.getElementById('patternTooltip'), this.dataset.tip);
  });
});

/* ================= 生成守护卡 ================= */
function generateCard() {
  document.getElementById('cardDesc').innerHTML =
    `釉色：${glazeName[currentGlaze]}<br>纹饰：${patternName[currentPattern]}`;

  const key = `${currentGlaze}-${currentPattern}`;
  document.getElementById('cardSlogan').textContent =
    sloganMap[key] || '守一方烟火，承千年匠心';

  goToPage(5);
}

/* ================= Canvas 绘图工具 ================= */
function rrCustom(ctx, x, y, w, h, rTL, rTR, rBR, rBL) {
  ctx.beginPath();
  ctx.moveTo(x + rTL, y);
  ctx.lineTo(x + w - rTR, y);
  ctx.arcTo(x + w, y, x + w, y + rTR, rTR);
  ctx.lineTo(x + w, y + h - rBR);
  ctx.arcTo(x + w, y + h, x + w - rBR, y + h, rBR);
  ctx.lineTo(x + rBL, y + h);
  ctx.arcTo(x, y + h, x, y + h - rBL, rBL);
  ctx.lineTo(x, y + rTL);
  ctx.arcTo(x, y, x + rTL, y, rTL);
  ctx.closePath();
}
function rr(ctx, x, y, w, h, r) {
  rrCustom(ctx, x, y, w, h, r, r, r, r);
}

